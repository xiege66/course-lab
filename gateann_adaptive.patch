+  // Exact for a single tag; min marginal is an upper bound for a conjunction.
+  // This is a budget hint, never a filter predicate or a recall guarantee.
+  double estimate_selectivity(const void *filter_data) const {
+    if (!filter_data || !n_nodes_) return 1.0;
+    const auto *q = static_cast<const uint32_t *>(filter_data);
+    double s = 1.0;
+    for (uint32_t j = 1; j <= q[0]; ++j) {
+      if (q[j] >= label_counts_.size()) return 0.0;
+      s = std::min(s, double(label_counts_[q[j]]) / n_nodes_);
+    }
+    return s;
+  }
   bool loaded() const { return n_nodes_ > 0; }
   size_t size() const { return n_nodes_; }
 
